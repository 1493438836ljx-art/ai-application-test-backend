<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.huawei.cloudopenlabs.workflow.mapper.WorkflowNodeMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.huawei.cloudopenlabs.workflow.entity.WorkflowNodeEntity">
        <id column="id" property="id"/>
        <result column="workflow_id" property="workflowId"/>
        <result column="node_uuid" property="nodeUuid"/>
        <result column="type" property="type"/>
        <result column="type_id" property="typeId"/>
        <result column="name" property="name"/>
        <result column="position_x" property="positionX"/>
        <result column="position_y" property="positionY"/>
        <result column="input_ports" property="inputPorts"/>
        <result column="output_ports" property="outputPorts"/>
        <result column="input_params" property="inputParams"/>
        <result column="output_params" property="outputParams"/>
        <result column="config" property="config"/>
        <result column="parent_node_id" property="parentNodeId"/>
        <!-- Skill引用 -->
        <result column="skill_id" property="skillId"/>
        <result column="skill_snapshot" property="skillSnapshot"/>
        <!-- 执行配置 -->
        <result column="execution_location" property="executionLocation"/>
        <result column="error_strategy" property="errorStrategy"/>
        <result column="retry_count" property="retryCount"/>
        <result column="retry_interval" property="retryInterval"/>
        <result column="error_branch_id" property="errorBranchId"/>
        <!-- 条件节点配置 -->
        <result column="condition_type" property="conditionType"/>
        <result column="conditions" property="conditions"/>
        <!-- 循环节点配置 -->
        <result column="loop_type" property="loopType"/>
        <result column="loop_config" property="loopConfig"/>
        <!-- 批处理/异步/收集配置 -->
        <result column="batch_config" property="batchConfig"/>
        <result column="async_config" property="asyncConfig"/>
        <result column="collect_config" property="collectConfig"/>
        <!-- 兼容性状态 -->
        <result column="compatibility_status" property="compatibilityStatus"/>
        <result column="node_category" property="nodeCategory"/>
        <!-- 时间字段 -->
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, workflow_id, node_uuid, type, type_id, name, position_x, position_y,
        input_ports, output_ports, input_params, output_params, config,
        parent_node_id, skill_id, skill_snapshot,
        execution_location, error_strategy, retry_count, retry_interval, error_branch_id,
        condition_type, conditions, loop_type, loop_config,
        batch_config, async_config, collect_config,
        compatibility_status, node_category,
        created_at, updated_at
    </sql>

    <!-- 根据工作流ID查询所有节点 -->
    <select id="selectByWorkflowId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM workflow_node
        WHERE workflow_id = #{workflowId}
        ORDER BY created_at ASC
    </select>

    <!-- 根据工作流ID和节点UUID查询 -->
    <select id="selectByWorkflowIdAndNodeUuid" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM workflow_node
        WHERE workflow_id = #{workflowId}
        AND node_uuid = #{nodeUuid}
        LIMIT 1
    </select>

    <!-- 根据工作流ID和节点类型查询 -->
    <select id="selectByWorkflowIdAndType" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM workflow_node
        WHERE workflow_id = #{workflowId}
        AND type = #{type}
        ORDER BY created_at ASC
    </select>

    <!-- 查询指定节点的子节点 -->
    <select id="selectByParentNodeId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM workflow_node
        WHERE parent_node_id = #{parentNodeId}
        ORDER BY created_at ASC
    </select>

    <!-- 删除工作流的所有节点 -->
    <delete id="deleteByWorkflowId">
        DELETE FROM workflow_node
        WHERE workflow_id = #{workflowId}
    </delete>

    <!-- 统计工作流的节点数量 -->
    <select id="countByWorkflowId" resultType="java.lang.Long">
        SELECT COUNT(*)
        FROM workflow_node
        WHERE workflow_id = #{workflowId}
    </select>

    <!-- 根据Skill ID查询所有引用该Skill的节点 -->
    <select id="selectBySkillId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM workflow_node
        WHERE skill_id = #{skillId}
        ORDER BY created_at DESC
    </select>

    <!-- 批量更新节点兼容性状态 -->
    <update id="batchUpdateCompatibilityStatus">
        UPDATE workflow_node
        SET compatibility_status = #{status},
            updated_at = CURRENT_TIMESTAMP
        WHERE id IN
        <foreach collection="nodeIds" item="nodeId" open="(" separator="," close=")">
            #{nodeId}
        </foreach>
    </update>

</mapper>
